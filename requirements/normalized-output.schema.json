{
  "type": "object",
  "required": [
    "notice_id",
    "source_sha256",
    "classification",
    "disposition",
    "reason_codes",
    "evidence_refs",
    "recommendation_allowed"
  ],
  "additionalProperties": false,
  "properties": {
    "notice_id": {
      "type": "integer"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "SIGNAL_CANDIDATE",
        "NON_SIGNAL",
        "UNRESOLVED"
      ],
      "description": "A proposal, never authorization."
    },
    "disposition": {
      "type": "string",
      "enum": [
        "CANDIDATE_ONLY",
        "NO_SIGNAL",
        "SUPPRESSED",
        "REVIEW_REQUIRED",
        "ERROR"
      ],
      "description": "Distinct from harness PASS/FAIL/ERROR/UNKNOWN."
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Rule ID or explicit input-contract error."
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation_allowed": {
      "const": false,
      "description": "This classifier has no D6 authorization interface; publication is a separate existing component."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized classifier proposal v1"
}
